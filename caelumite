#!/usr/bin/env bash
# Start Caelumite from source (run scripts/setup-macos.sh once first).
# Runs through build/Caelumite.app when it exists (scripts/build-app.sh), so
# macOS shows the Caelumite name and icon instead of Python's.
ROOT="$(cd "$(dirname "$0")" && pwd)"
APP="$ROOT/build/Caelumite.app/Contents/MacOS"
if [ -x "$APP/Caelumite" ]; then
    # The bundle's interpreter goes stale when Homebrew's Python is removed
    # or .venv is rebuilt; fall back to .venv rather than fail to start.
    if "$APP/caelumite-python" -c 'import PySide6' 2>/dev/null; then
        exec "$APP/Caelumite" "$@"
    fi
    echo "warning: build/Caelumite.app no longer starts - rebuild it with" \
         "scripts/build-app.sh; running from .venv instead" >&2
fi
cd "$ROOT/src" || exit 1
if [ ! -x ../.venv/bin/python ]; then
    echo "error: .venv missing - run scripts/setup-macos.sh first" >&2
    exit 1
fi
exec ../.venv/bin/python run_qt.py "$@"
